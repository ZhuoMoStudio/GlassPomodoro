<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 麦克风权限（声波动效检测用） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 前台服务权限（Android 13+ 通知） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 网络权限（Bing壁纸） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 音频可视化：Visualizer 输出混音与麦克风 FFT 所需 -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 查询正在播放的媒体应用（Android 11+ 需要，v2.0.2 扩展覆盖主流音乐 App） -->
    <queries>
        <intent>
            <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <package android:name="com.spotify.music" />
        <package android:name="com.apple.android.music" />
        <package android:name="com.netease.cloudmusic" />
        <package android:name="com.tencent.qqmusic" />
        <package android:name="com.kugou.android" />
        <package android:name="com.kuwo.kwmusicplayer" />
        <package android:name="com.ximalaya.ting.android" />
        <package android:name="com.douban.fm" />
        <package android:name="com.miui.player" />
        <package android:name="com.google.android.music" />
        <package android:name="com.samsung.android.music" />
        <package android:name="com.hihonor.music" />
        <package android:name="com.oppo.music" />
        <package android:name="com.sina.weibo" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.GlassPomodoro"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
